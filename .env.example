# 複製這個檔案為 .env 並填入實際值（.env 已被 .gitignore 忽略，不會進版控）
# ⚠️ 真正的密碼 / 金鑰請勿提交，也不要貼給任何人

# ---- 資料庫（MySQL／TiDB）----
# 共用的叢集連線。程式會保留帳密、Host 與連線參數，並自動切換至
# ini_dating 與 watchlab Database；URL 最後的 Database 名稱可使用 test。
#   DATABASE_URL="mysql://user:password@localhost:3306/test"
#
# 雲端（免費、不會過期）：擇一
#   TiDB Serverless（MySQL 相容，需 TLS）：
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DBNAME?sslaccept=strict"
#
#   Aiven for MySQL（需 TLS）：
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/test"

# ---- JWT 簽章密鑰 ----
# 部署到 Render 時由 render.yaml 的 generateValue 自動產生
JWT_SECRET="請換成一段夠長的隨機字串"

# ---- 伺服器埠 ----
# 本機開發用；Render 會自動提供 PORT，不用手填
PORT=3000

# ---- INI 執行模式 ----
# private-test：保留內建測試帳號與資料；production：API 隱藏並禁止登入測試帳號。
# Render 正式環境請明確設定為 production。
# 私人測試模式的本人帳號 ID；production 模式不會使用此設定。
INI_TEST_USER_ID=30001

# ---- 反向代理 ----
# Render 等代管平台通常為 1；本機開發可省略。設定錯誤可能影響依 IP 限流。
# TRUST_PROXY_HOPS=1

# ---- 驗證信（Gmail API HTTPS，適用 Render 免費方案）----
# Gmail API 必須啟用 gmail.send scope，Refresh Token 僅存後端環境變數。
EMAIL_PROVIDER=gmail_api
EMAIL_USER="ini.dating.verify@gmail.com"
EMAIL_FROM="INI Dating <ini.dating.verify@gmail.com>"
GMAIL_CLIENT_ID="your-google-oauth-client-id"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-google-oauth-refresh-token"

# Brevo HTTPS API 備援：
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY="xkeysib-your-api-key"

# Gmail SMTP 僅適用本機或允許 SMTP 的付費主機；Render 免費方案封鎖 SMTP。
# EMAIL_PROVIDER=gmail
# EMAIL_USER="ini.dating.verify@gmail.com"
# EMAIL_APP_PASSWORD="abcdefghijklmnop"

# ---- CORS 白名單（選填）----
# 額外允許的前端網址，逗號分隔。預設已含 localhost:3000。
# 前端部署到 Vercel 後，把它的網址填在這裡（Render 後台設定同名環境變數）。
# CORS_ORIGINS="https://your-stock-frontend.vercel.app"
